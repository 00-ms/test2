# Prefix for commands (default ".")
PREFIX=.

# Set to your number (with country code, no +, no spaces) e.g. 15551234567
# to log in with a pairing code instead of scanning a QR.
# Leave blank to use QR login.
PAIRING_NUMBER=

# Sticker pack metadata (used by .s)
STICKER_PACK=RobloxidBot
STICKER_AUTHOR=Robloxid

# Optional: .ROBLOSECURITY cookie for authenticated Roblox presence lookups
# (live online/in-game/studio status). Use a throwaway account. Leave blank
# to skip - bot will still work, just without live presence.
ROBLOSECURITY=
